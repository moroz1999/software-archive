# Copy to .env.prod and fill in (docs/deploy.md). .env.prod is never committed.

# Domain the site answers on; Caddy obtains its HTTPS certificate for it.
SITE_ADDRESS=test.zxart.ee

POSTGRES_USER=archive
POSTGRES_DB=archive
POSTGRES_PASSWORD=change-me

TYPESENSE_API_KEY=change-me

# Signs the session tokens; at least 32 bytes, e.g. `openssl rand -base64 48`.
AUTH_JWT_SECRET=change-me-to-at-least-32-random-bytes
