# Copy to .env.prod and fill in (docs/deploy.md). .env.prod is never committed.

# Domain the site answers on; Caddy obtains its HTTPS certificate for it.
SITE_ADDRESS=retroteka.org

POSTGRES_USER=archive
POSTGRES_DB=archive
POSTGRES_PASSWORD=change-me

TYPESENSE_API_KEY=change-me

# Signs the session tokens; at least 32 bytes, e.g. `openssl rand -base64 48`.
AUTH_JWT_SECRET=change-me-to-at-least-32-random-bytes

# SMTP relay the letters go through (STARTTLS on port 587). The sender domain needs SPF and DKIM at the relay.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
MAIL_FROM=no-reply@retroteka.org

# The OpenAI key of the AI assistant; left empty, the assistant answers that it is not configured.
OPENAI_API_KEY=
